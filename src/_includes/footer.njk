<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__logo-wrap">
      <img class="footer__logo" src="/assets/images/logo-trim.webp" alt="Makan Pizza" width="108" height="130" loading="lazy">
    </div>

    <div class="footer__info">
      <p class="footer__slogan">{{ site.slogan }}</p>
      <p>{{ site.zone }}</p>
      <p><a href="tel:{{ site.phoneIntl }}">{{ site.phone }}</a> · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>

    <div class="footer__social">
      <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram @makanpizza_officiel</a>
      <a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook @makanpizzaofficiel</a>
    </div>

    <ul class="footer__links">
      {%- if collections.articles.length %}
      <li><a href="/blog">Blog</a></li>
      {%- endif %}
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/cgv">Conditions générales</a></li>
      <li><a href="/confidentialite">Confidentialité</a></li>
    </ul>

    <p class="footer__legal">{{ site.legalLine }}</p>
  </div>
</footer>
