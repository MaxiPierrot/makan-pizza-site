---
layout: page.njk
permalink: /contact.html
path: /contact
crumb: "Contact"
title: "Demander un devis ou une date | Makan Pizza"
description: "Demandez un devis pour une pizza party ou une date pour un atelier pizza à domicile à Lyon. Je vous réponds par email ou par téléphone."
h1: "Demander un devis ou une date"
lead: "Indiquez-moi la date qui vous convient, le nombre de personnes et l'occasion : je vous réponds sous 24 h, par email ou par téléphone."
whatsappText: "Bonjour, je voudrais un devis ou une date pour un atelier ou une pizza party."
nofab: true
---
{# Emplacement du widget de réservation (SimplyBook) : à ajouter ici quand il sera branché, puis adapter le texte d'introduction. #}
<section class="section">
  <div class="container">
    <p class="contact-quick">Plus rapide : <a class="wa-link" href="{{ site.whatsappBase }}?text={{ whatsappText | urlencode }}" target="_blank" rel="noopener">{% include "wa-icon.njk" %}WhatsApp</a> ou <a href="tel:{{ site.phoneIntl }}">{{ site.phone }}</a></p>
    <div class="estimate-band">
      <p><strong>Votre projet est déjà défini ?</strong> Répondez à quelques questions et obtenez une estimation du tarif, déplacement compris, en cinq minutes.</p>
      <a href="/preparer-mon-atelier" class="btn btn--primary">{{ site.ctaEstimer }}</a>
    </div>
  </div>
  <div class="container contact-grid">
    <form class="form" name="contact" method="POST" action="/merci" data-netlify="true" netlify-honeypot="bot-field" data-sauvegarde="contact-v1">
      <input type="hidden" name="form-name" value="contact">
      <p class="form__hp" aria-hidden="true"><label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>

      <div class="form__row">
        <label for="nom">Nom <span class="req" aria-hidden="true">*</span></label>
        <input type="text" id="nom" name="nom" autocomplete="name" required aria-required="true">
      </div>
      <div class="form__row">
        <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
        <input type="email" id="email" name="email" autocomplete="email" required aria-required="true">
      </div>
      <div class="form__row">
        <label for="telephone">Téléphone</label>
        <input type="tel" id="telephone" name="telephone" autocomplete="tel">
      </div>
      <div class="form__row">
        <label for="atelier">Type de demande <span class="req" aria-hidden="true">*</span></label>
        <select id="atelier" name="type_de_demande" required aria-required="true">
          <option value="" selected disabled>Choisissez</option>
          <option value="bases">Bases de la pizza maison</option>
          <option value="initiation">Initiation à la pizza napolitaine</option>
          <option value="pizza-party">Pizza party</option>
          <option value="sur-mesure">Événement sur mesure</option>
          <option value="bon-cadeau">Offrir un bon cadeau</option>
          <option value="autre">Autre</option>
        </select>
      </div>
      <div class="form__cols" id="bon-champs" data-bon-champs hidden>
        <div class="form__row">
          <label for="pour-qui">Pour qui (prénom)</label>
          <input type="text" id="pour-qui" name="bon_pour">
        </div>
        <div class="form__row">
          <label for="de-la-part">De la part de</label>
          <input type="text" id="de-la-part" name="bon_de_la_part_de">
        </div>
      </div>
      <div class="form__cols">
        <div class="form__row">
          <label for="date">Date souhaitée</label>
          <input type="date" id="date" name="date_souhaitee">
        </div>
        <div class="form__row">
          <label for="personnes">Nombre de personnes</label>
          <input type="number" id="personnes" name="nombre_de_personnes" min="1" inputmode="numeric">
        </div>
      </div>
      <div class="form__row">
        <label for="commune">Quartier ou commune</label>
        <input type="text" id="commune" name="quartier_ou_commune" autocomplete="address-level2">
      </div>
      <div class="form__row">
        <label for="connu">Comment m'avez-vous connu ?</label>
        <select id="connu" name="comment_connu">
          <option value="">Choisissez</option>
          <option>Instagram</option>
          <option>Facebook</option>
          <option>Google</option>
          <option>Par une connaissance</option>
          <option>J'ai reçu un bon cadeau</option>
          <option>Autre</option>
        </select>
      </div>
      <input type="hidden" name="source" id="source" value="">
      <div class="form__row">
        <label for="message">Message <span class="req" aria-hidden="true">*</span></label>
        <textarea id="message" name="message" rows="6" required aria-required="true"></textarea>
      </div>
      <p class="form__legend"><span class="req" aria-hidden="true">*</span> Champ obligatoire</p>
      <div class="prep__send-error" role="alert" data-erreur hidden></div>
      <button type="submit" class="btn btn--primary">Envoyer ma demande</button>
      <button type="button" class="btn btn--secondary" data-export>Exporter ma demande</button>
      <p class="prep__hint">Écrivez directement sur cette page. Votre message est enregistré sur cet appareil au fil de la saisie et réapparaît si la page se recharge.</p>
    </form>

    <aside class="contact-card" aria-label="Coordonnées">
      <p><a href="tel:{{ site.phoneIntl }}">{{ site.phone }}</a></p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p class="contact-card__reply">Je réponds sous 24 h.</p>
      <p><a class="btn wa-btn" href="{{ site.whatsappBase }}?text={{ (whatsappText or site.whatsappText) | urlencode }}" target="_blank" rel="noopener">{% include "wa-icon.njk" %}WhatsApp</a></p>
    </aside>
  </div>
</section>
<script src="/assets/js/form-sauvegarde.js" defer></script>
