{# Galerie temporaire : remplace la page « La carte » (en pause) jusqu'à la séance photo. Photos : src/_data/galerie.js #}
<section class="section">
  <div class="container">
    <ul class="galerie">
      {% for p in galerie %}
      <li><div class="photo-slot galerie__photo"><img src="{{ p.small }}" srcset="{{ p.small }} 600w, {{ p.src }} 1200w" sizes="(min-width: 900px) 33vw, 50vw" alt="{{ p.alt }}" width="600" height="600" loading="{{ 'eager' if loop.index <= 4 else 'lazy' }}" decoding="async"></div></li>
      {% endfor %}
    </ul>
    <p class="date-cta__actions"><a href="/contact" class="btn btn--primary">Demander une date</a></p>
  </div>
</section>
